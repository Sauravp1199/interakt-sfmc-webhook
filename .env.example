# =============================================================================
# Interakt to SFMC Webhook Server Configuration
# =============================================================================

# Server Configuration
NODE_ENV=development
PORT=1112

# =============================================================================
# Salesforce Marketing Cloud Configuration
# =============================================================================
# Auth URL for OAuth token generation
SFMC_AUTH_BASE_URL=https://YOUR_SUBDOMAIN.auth.marketingcloudapis.com

# REST API Base URL for Data Extension operations
SFMC_REST_BASE_URL=https://YOUR_SUBDOMAIN.rest.marketingcloudapis.com

# OAuth Credentials (from SFMC Setup > Apps > Installed Packages)
SFMC_CLIENT_ID=your_client_id_here
SFMC_CLIENT_SECRET=your_client_secret_here
SFMC_ACCOUNT_ID=your_account_id_here

# =============================================================================
# Data Extension Configuration
# =============================================================================
# Unified Data Extension Customer Key (for ALL webhook events)
# This is read from .env and used for the REST API rowset endpoint
# Example: E991E42A-69A0-41BF-9542-FADB50F48AB5
SFMC_DE_CUSTOMER_KEY=YOUR_DATA_EXTENSION_CUSTOMER_KEY

# =============================================================================
# Queue Configuration (for batch processing)
# =============================================================================
# Batch size for rowset API (200-500 recommended, max 500)
QUEUE_BATCH_SIZE=200

# Max request size in bytes (4MB SFMC limit, use 4000000 for safety)
QUEUE_MAX_REQUEST_SIZE=4000000

# Flush interval in milliseconds (how often to process queue)
QUEUE_FLUSH_INTERVAL=5000

# Max requests per minute (SFMC soft limit ~2500, use 2000 for safety)
QUEUE_RATE_LIMIT=2000

# Set to 'false' to disable queue and process immediately (not recommended for production)
USE_QUEUE=true

# =============================================================================
# Security Configuration
# =============================================================================
# Interakt webhook signature secret (for production)
INTERAKT_SECRET=your_interakt_webhook_secret

# Admin key for cache/queue management endpoints
ADMIN_KEY=your_admin_key_here

# =============================================================================
# LOCAL Environment Credentials (for localhost testing)
# These override the production credentials when running locally
# =============================================================================
LOCAL_ADMIN_KEY=local_admin_key_2026
LOCAL_INTERAKT_SECRET=local_interakt_secret_2026

# =============================================================================
# Logging Configuration
# =============================================================================
# Log levels: ERROR, WARN, INFO, DEBUG
LOG_LEVEL=INFO
