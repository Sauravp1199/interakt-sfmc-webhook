# ========================================
# Redis Queue Configuration
# ========================================

# Redis Connection (required for queue system)
REDIS_URL=redis://localhost:6379

# ========================================
# Queue Batch Configuration
# ========================================

# Maximum number of messages to batch together
# - Lower (10-20): Lower latency, more API calls
# - Higher (50-100): Better throughput, higher latency
QUEUE_BATCH_SIZE=30

# Maximum total size of batch in bytes
# Typical SFMC API limit: 10MB, we use 1MB for safety
QUEUE_BATCH_BYTES=1048576

# Timeout before sending partial batch (in milliseconds)
# If batch < size but timeout reached, send anyway
QUEUE_BATCH_TIMEOUT=5000

# ========================================
# Queue Retry Configuration
# ========================================

# Maximum number of retry attempts
# Messages exceeding this are moved to bad payload DLQ
QUEUE_MAX_RETRIES=5

# Initial retry delay in milliseconds
# First retry happens at this delay
QUEUE_RETRY_INITIAL_DELAY=5000

# Maximum retry delay in milliseconds
# Backoff won't exceed this
QUEUE_RETRY_MAX_DELAY=300000

# Exponential backoff multiplier
# Each retry delay = previous delay * multiplier
QUEUE_RETRY_BACKOFF=2.0

# ========================================
# Worker Configuration
# ========================================

# Enable batch processing worker
# Set to 'false' to disable batch processing
BATCH_WORKER_ENABLED=true

# Batch worker poll interval (milliseconds)
# How often to check for messages to batch and process
BATCH_WORKER_POLL_INTERVAL=2000

# Enable retry processing worker
# Set to 'false' to disable retry processing
RETRY_WORKER_ENABLED=true

# Queue size threshold for idle detection
# System is "idle" when main queue has fewer than this many messages
RETRY_IDLE_THRESHOLD=5

# Duration to be idle before starting retry processing (milliseconds)
# System must be idle for this long before processing retries
RETRY_IDLE_DURATION=10000

# Retry worker poll interval (milliseconds)
# How often to check if system is idle
RETRY_POLL_INTERVAL=5000

# ========================================
# Admin Configuration
# ========================================

# Secret key for admin endpoints (e.g., clearing queues)
# Required header: x-admin-secret
ADMIN_SECRET=your-super-secret-key-change-in-production

# ========================================
# Original Configuration (Keep Existing)
# ========================================

PORT=1112
NODE_ENV=development
LOG_LEVEL=info

# SFMC Authentication
SFMC_AUTH_BASE_URL=https://mc72wv4hqz48m1slvbncl40nnlv4.auth.marketingcloudapis.com
SFMC_SOAP_BASE_URL=https://mc72wv4hqz48m1slvbncl40nnlv4.soap.marketingcloudapis.com
SFMC_CLIENT_ID=your-client-id
SFMC_CLIENT_SECRET=your-client-secret
SFMC_ACCOUNT_ID=your-account-id

# Data Extension Keys
DE_WEBHOOK_MASTER=your-master-de-key
DE_WEBHOOK_EVENTS=9E205464-0FD8-4D1A-A57D-39F92C70D2C9
SFMC_DE_CUSTOMER_KEY=402A0395-7B93-4866-AF97-530424622A9F

# Environment-specific Credentials (LOCAL)
LOCAL_ADMIN_KEY=local-admin-key
LOCAL_INTERAKT_SECRET=local-interakt-secret
LOCAL_WEBHOOK_SIGNATURE=local-webhook-signature

# Environment-specific Credentials (PRODUCTION)
PROD_ADMIN_KEY=prod-admin-key
PROD_INTERAKT_SECRET=prod-interakt-secret
PROD_WEBHOOK_SIGNATURE=prod-webhook-signature

# ========================================
# Performance Tuning Examples
# ========================================

# For HIGH VOLUME (1000+ messages/minute):
# QUEUE_BATCH_SIZE=50
# QUEUE_BATCH_BYTES=2097152
# QUEUE_BATCH_TIMEOUT=3000
# BATCH_WORKER_POLL_INTERVAL=1000

# For LOW LATENCY requirements:
# QUEUE_BATCH_SIZE=10
# QUEUE_BATCH_TIMEOUT=1000
# BATCH_WORKER_POLL_INTERVAL=500

# For STABILITY (Conservative settings):
# QUEUE_BATCH_SIZE=20
# QUEUE_MAX_RETRIES=3
# QUEUE_RETRY_INITIAL_DELAY=10000
# RETRY_IDLE_DURATION=20000
