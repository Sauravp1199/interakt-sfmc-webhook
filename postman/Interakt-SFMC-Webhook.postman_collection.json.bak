						"body": {
							"mode": "raw",
							"raw": "{\n  \"version\": \"1.0\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"type\": \"message_received\",\n  \"data\": {\n    \"customer\": {\n      \"id\": \"52918eb3-bd00-4331-a51d-c4dcffee48d6\",\n      \"channel_phone_number\": \"917003705584\",\n      \"phone_number\": \"7003705584\",\n      \"country_code\": \"91\",\n      \"traits\": {\n        \"name\": \"SKGG\",\n        \"email\": \"xyz@gmail.com\",\n        \"whatsapp_opted_in\": true\n      }\n    },\n    \"message\": {\n      \"id\": \"msg_received_{{$randomUUID}}\",\n      \"chat_message_type\": \"CustomerMessage\",\n      \"message_status\": \"Received\",\n      \"received_at_utc\": \"{{$isoTimestamp}}\",\n      \"is_template_message\": false,\n      \"message_content_type\": \"Text\",\n      \"message\": \"Hello, I have a question about my order\",\n      \"media_url\": null,\n      \"meta_data\": {\n        \"source\": \"WhatsApp\"\n      }\n    }\n  }\n}"
