						"body": {
							"mode": "raw",
							"raw": "{\n  \"version\": \"1.0\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"type\": \"message_api_clicked\",\n  \"data\": {\n    \"customer\": {\n      \"id\": \"52918eb3-bd00-4331-a51d-c4dcffee48d6\",\n      \"channel_phone_number\": \"917003705584\",\n      \"traits\": {\n        \"name\": \"SKGG\",\n        \"email\": \"xyz@gmail.com\"\n      }\n    },\n    \"message\": {\n      \"id\": \"msg_qr_click_{{$randomUUID}}\",\n      \"chat_message_type\": \"PublicApiMessage\",\n      \"message_status\": \"Read\",\n      \"received_at_utc\": \"2022-06-03T05:43:33.133000\",\n      \"delivered_at_utc\": \"2022-06-03T05:43:33.848000\",\n      \"seen_at_utc\": \"2022-06-03T05:44:00.000000\",\n      \"is_template_message\": true,\n      \"message_content_type\": \"Template\",\n      \"meta_data\": {\n        \"source\": \"PublicInterakt\",\n        \"click_type\": \"QR\",\n        \"button_text\": \"Yes, I'm interested\",\n        \"click_timestamp\": \"{{$isoTimestamp}}\",\n        \"button_payload\": {\n          \"payload\": {\n            \"type\": \"text\",\n            \"text\": \"interested_yes\"\n          }\n        },\n        \"source_data\": {\n          \"callback_data\": \"campaign_123\"\n        }\n      }\n    }\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/webhook/interakt",
							"host": ["{{base_url}}"],
							"path": ["webhook", "interakt"]
						},
						"description": "Webhook fired when user clicks a Quick Reply button."
