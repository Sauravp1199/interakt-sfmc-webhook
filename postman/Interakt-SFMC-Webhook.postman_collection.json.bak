							"raw": "{\n  \"version\": \"1.0\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"type\": \"message_api_clicked\",\n  \"data\": {\n    \"customer\": {\n      \"id\": \"52918eb3-bd00-4331-a51d-c4dcffee48d6\",\n      \"channel_phone_number\": \"917003705584\",\n      \"traits\": {\n        \"name\": \"SKGG\",\n        \"email\": \"xyz@gmail.com\"\n      }\n    },\n    \"message\": {\n      \"id\": \"msg_cta_click_{{$randomUUID}}\",\n      \"chat_message_type\": \"PublicApiMessage\",\n      \"message_status\": \"Read\",\n      \"is_template_message\": true,\n      \"message_content_type\": \"Template\"\n    },\n    \"event\": {\n      \"callbackData\": \"order_tracking_123\",\n      \"click_type\": \"CTA\",\n      \"button_text\": \"Track Order\",\n      \"button_link\": \"https://example.com/track/123\",\n      \"click_timestamp\": \"{{$isoTimestamp}}\"\n    }\n  }\n}"
