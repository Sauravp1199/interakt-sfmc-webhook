{
	"info": {
		"_postman_id": "a1b2c3d4-e5f6-7890-abcd-ef1234567890",
		"name": "Interakt SFMC Webhook API v2",
		"description": "Collection to test the Interakt to Salesforce Marketing Cloud Webhook Integration API v2.0.\n\n## Single Webhook Endpoint\nAll webhook types hit the same endpoint: `POST /webhook/interakt`\nOnly the request payload changes per event type.\n\n## Supported Webhook Types (15 Total)\n\n### Message Status Events (4)\n- message_api_sent\n- message_api_delivered\n- message_api_read\n- message_api_failed\n\n### Interactions (3)\n- Button Click - Quick Reply (message_api_clicked with click_type=QR)\n- Button Click - CTA (message_api_clicked with click_type=CTA)\n- Incoming Message - Text (message_received)\n- Workflow Response (workflow_response_update)\n\n### Account Events (5)\n- account_alerts\n- account_update\n- account_review_update\n- business_capability_update\n- phone_number_quality_update\n\n### Template Events (3)\n- template_performance_metrics\n- message_template_status_update\n- messages (generic)\n\n## Environment Variables\n| Variable | Value |\n|----------|-------|\n| base_url | http://localhost:1112 |\n| admin_key | local_admin_key_2026 |",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Health & Status",
			"item": [
				{
					"name": "Root - Service Info",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/",
							"host": ["{{base_url}}"],
							"path": [""]
						},
						"description": "Returns service information and available endpoints."
					},
					"response": []
				},
				{
					"name": "Health Check",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/health",
							"host": ["{{base_url}}"],
							"path": ["health"]
						},
						"description": "Returns health status including uptime, memory usage, queue stats, SFMC token status."
					},
					"response": []
				},
				{
					"name": "Statistics",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/stats",
							"host": ["{{base_url}}"],
							"path": ["stats"]
						},
						"description": "Returns request statistics and queue metrics."
					},
					"response": []
				}
			],
			"description": "Endpoints for monitoring application health and status."
		},
		{
			"name": "Admin",
			"item": [
				{
					"name": "Clear Cache",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-admin-key",
								"value": "{{admin_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/admin/clear-cache",
							"host": ["{{base_url}}"],
							"path": ["admin", "clear-cache"]
						},
						"description": "Clears the idempotency cache and SFMC token cache."
					},
					"response": []
				},
				{
					"name": "Flush Queue",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "x-admin-key",
								"value": "{{admin_key}}",
								"type": "text"
							}
						],
						"url": {
							"raw": "{{base_url}}/admin/flush-queue",
							"host": ["{{base_url}}"],
							"path": ["admin", "flush-queue"]
						},
						"description": "Force flush the queue to immediately send all pending records to SFMC."
					},
					"response": []
				}
			],
			"description": "Administrative endpoints for cache and queue management."
		},
