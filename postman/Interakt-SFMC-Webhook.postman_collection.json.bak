						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"version\": \"1.0\",\n  \"timestamp\": \"{{$isoTimestamp}}\",\n  \"type\": \"workflow_response_update\",\n  \"data\": {\n    \"id\": \"wf_resp_{{$randomUUID}}\",\n    \"created_at_utc\": \"2024-01-15T10:00:00Z\",\n    \"modified_at_utc\": \"{{$isoTimestamp}}\",\n    \"workflow_id\": \"wf_survey_123\",\n    \"customer_id\": \"52918eb3-bd00-4331-a51d-c4dcffee48d6\",\n    \"customer_name\": \"SKGG\",\n    \"customer_number\": \"917003705584\",\n    \"triggered_from\": \"API\",\n    \"data\": [\n      {\n        \"question\": {\n          \"id\": \"q1_{{$randomUUID}}\",\n          \"step_number\": 1,\n          \"message\": \"How would you rate our service?\",\n          \"message_type\": \"ListMessage\",\n          \"list_message_name\": \"Rating Options\",\n          \"user_trait_name\": \"service_rating\"\n        },\n        \"answer\": {\n          \"id\": \"a1_{{$randomUUID}}\",\n          \"message\": \"Excellent\",\n          \"received_at_utc\": \"2024-01-15T10:01:00Z\",\n          \"message_content_type\": \"Text\"\n        }\n      },\n      {\n        \"question\": {\n          \"id\": \"q2_{{$randomUUID}}\",\n          \"step_number\": 2,\n          \"message\": \"Would you recommend us to others?\",\n          \"message_type\": \"QuickReply\",\n          \"user_trait_name\": \"would_recommend\"\n        },\n        \"answer\": {\n          \"id\": \"a2_{{$randomUUID}}\",\n          \"message\": \"Yes, definitely!\",\n          \"received_at_utc\": \"{{$isoTimestamp}}\",\n          \"message_content_type\": \"Text\"\n        }\n      }\n    ]\n  }\n}"
						},
						"url": {
							"raw": "{{base_url}}/webhook/interakt",
							"host": ["{{base_url}}"],
							"path": ["webhook", "interakt"]
						},
						"description": "Webhook fired when a workflow response is updated. Contains Q&A pairs."
					},
					"response": []
				}
			],
			"description": "Interaction webhooks: button clicks, incoming messages, workflow responses."
		},
