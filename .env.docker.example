# ========================================
# Docker Environment Configuration
# ========================================
# Copy this file: cp .env.docker.example .env.docker
# Then update with your actual values
# ========================================

# ========================================
# Application Configuration
# ========================================
NODE_ENV=production
PORT=1112
LOG_LEVEL=info

# ========================================
# Redis Configuration
# ========================================
# In Docker Compose, use: redis://redis:6379
# For external Redis: redis://host:6379
REDIS_URL=redis://redis:6379

# ========================================
# SFMC (Salesforce Marketing Cloud)
# ========================================
SFMC_AUTH_BASE_URL=https://mc72wv4hqz48m1slvbncl40nnlv4.auth.marketingcloudapis.com
SFMC_SOAP_BASE_URL=https://mc72wv4hqz48m1slvbncl40nnlv4.soap.marketingcloudapis.com
SFMC_CLIENT_ID=your-client-id-here
SFMC_CLIENT_SECRET=your-client-secret-here
SFMC_ACCOUNT_ID=your-account-id-here

# ========================================
# Data Extension Keys
# ========================================
DE_WEBHOOK_MASTER=your-master-de-key-here
DE_WEBHOOK_EVENTS=9E205464-0FD8-4D1A-A57D-39F92C70D2C9
SFMC_DE_CUSTOMER_KEY=402A0395-7B93-4866-AF97-530424622A9F

# ========================================
# Webhook Credentials
# ========================================
# LOCAL environment (for localhost requests)
LOCAL_INTERAKT_SECRET=local-interakt-secret-key
LOCAL_ADMIN_KEY=local-admin-key

# PRODUCTION environment (for production domain)
PROD_INTERAKT_SECRET=prod-interakt-secret-key
PROD_ADMIN_KEY=prod-admin-key

# ========================================
# Queue Configuration
# ========================================

# Batch Settings
QUEUE_BATCH_SIZE=30                    # Messages per batch
QUEUE_BATCH_BYTES=1048576              # Max batch size (bytes)
QUEUE_BATCH_TIMEOUT=5000               # Timeout (ms)

# Retry Settings
QUEUE_MAX_RETRIES=5                    # Max retry attempts
QUEUE_RETRY_INITIAL_DELAY=5000         # Initial delay (ms)
QUEUE_RETRY_MAX_DELAY=300000           # Max delay (ms)
QUEUE_RETRY_BACKOFF=2.0                # Backoff multiplier

# Worker Settings
BATCH_WORKER_ENABLED=true              # Enable batch worker
BATCH_WORKER_POLL_INTERVAL=2000        # Poll interval (ms)
RETRY_WORKER_ENABLED=true              # Enable retry worker
RETRY_IDLE_THRESHOLD=5                 # Idle queue threshold
RETRY_IDLE_DURATION=10000              # Idle duration (ms)
RETRY_POLL_INTERVAL=5000               # Poll interval (ms)

# ========================================
# Admin Configuration
# ========================================
ADMIN_SECRET=docker-admin-secret-change-in-production

# ========================================
# Logging
# ========================================
LOG_LEVEL=info                         # debug, info, warn, error
